{
  "name": "linco-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Linco Harness backend. Pi Agent runs the model loop. Linco owns sessions, workers, tools, memory, and automation.",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "linco": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
